{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "target": "ES2023"
  },
  "include": ["site.ts"]
}
